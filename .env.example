# Copie este arquivo para ".env" (na raiz do projeto) antes de rodar `docker compose up`.
# O ".env" nao deve ser commitado - ja esta no .gitignore.

# Banco de dados - em producao use uma senha forte e unica.
DB_USER=servico_ja
DB_PASSWORD=servico_ja

# Seguranca - GERE um segredo forte e unico para producao (nunca reaproveite o valor de exemplo).
# Sugestao: openssl rand -base64 48
JWT_SECRET=dev-segredo-servico-ja-troque-em-producao-32-bytes-min
JWT_EXPIRACAO_ACESSO_MIN=60
JWT_EXPIRACAO_REFRESH_DIAS=30

# CORS - so afeta clientes web (o app mobile nao usa CORS). Lista separada por virgulas.
# "*" serve para desenvolvimento; em producao deixe vazio ou informe apenas os dominios
# reais de um painel web (ex.: https://admin.servicoja.com.br).
CORS_ALLOWED_ORIGINS=*

# Administrador inicial, criado enquanto nao existir nenhum ADMIN no banco.
# - Em producao (SPRING_PROFILES_ACTIVE=prod) a senha e obrigatoria (minimo 12 caracteres).
#   Depois do primeiro login, troque a senha pelo app e remova-a deste arquivo.
# - Fora de producao, se ficar vazia, uma senha aleatoria e gerada e exibida no log.
ADMIN_SEED_EMAIL=admin@servicoja.com.br
ADMIN_SEED_SENHA=

# Diretorio onde as fotos/logos enviados pelos usuarios sao gravados (dentro do container
# ja aponta para /app/uploads, montado como volume no docker-compose.yml).
UPLOAD_DIR=./uploads

# Asaas (gateway de pagamento). Com ASAAS_API_KEY vazia, os pagamentos ficam desativados.
# Producao: ASAAS_URL=https://api.asaas.com (o /v3 e acrescentado pela aplicacao).
# ASAAS_WEBHOOK_TOKEN: 32 a 255 caracteres (sugestao: openssl rand -hex 32). Cadastre o
# mesmo valor como "Token de autenticacao" do webhook no painel do Asaas.
ASAAS_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_VALOR_MENSAL=49.90
ASAAS_VALOR_ANUAL=479.00

# E-mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# App - URL publica da API (em producao, com HTTPS), usada nas URLs das fotos/logos.
APP_BASE_URL=http://localhost:8080
CIDADE_PADRAO=Marau
UF_PADRAO=RS

# Defina como "prod" apenas em producao de verdade: exige um JWT_SECRET forte, desliga o
# Swagger e as empresas de exemplo e fecha o CORS por padrao.
SPRING_PROFILES_ACTIVE=
