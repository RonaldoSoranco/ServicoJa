# Copie este arquivo para ".env" (na raiz do projeto) antes de rodar `docker compose up`.
# O ".env" nao deve ser commitado - ja esta no .gitignore.

# Banco de dados
DB_USER=servico_ja
DB_PASSWORD=servico_ja

# Seguranca - GERE um segredo forte e unico para producao (nunca reaproveite o valor de exemplo).
# Sugestao: openssl rand -base64 48
JWT_SECRET=dev-segredo-servico-ja-troque-em-producao-32-bytes-min
JWT_EXPIRACAO_ACESSO_MIN=60
JWT_EXPIRACAO_REFRESH_DIAS=30

# CORS - em producao, restrinja aos dominios reais do app/admin (ex.: https://app.servicoja.com.br).
# Aceita uma lista separada por virgulas. "*" so deve ser usado em desenvolvimento.
CORS_ALLOWED_ORIGINS=*

# Administrador inicial (seed). Se ADMIN_SEED_SENHA ficar vazio, uma senha aleatoria e
# gerada e impressa no log na primeira inicializacao - copie-a dali e troque-a depois do
# primeiro login. Esse seed so roda quando SPRING_PROFILES_ACTIVE != prod.
ADMIN_SEED_EMAIL=admin@servicoja.com.br
ADMIN_SEED_SENHA=

# Diretorio onde as fotos/logos enviados pelos usuarios sao gravados (dentro do container
# ja aponta para /app/uploads, montado como volume no docker-compose.yml).
UPLOAD_DIR=./uploads

# Asaas (gateway de pagamento)
ASAAS_URL=https://sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_SEGREDO=
ASAAS_VALOR_MENSAL=49.90
ASAAS_VALOR_ANUAL=479.00

# E-mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# App
APP_BASE_URL=http://localhost:8080
CIDADE_PADRAO=Marau
UF_PADRAO=RS

# Defina como "prod" apenas em producao de verdade: ativa a validacao de um JWT_SECRET
# forte e desativa o seed de administrador/categorias/empresas de exemplo.
SPRING_PROFILES_ACTIVE=
